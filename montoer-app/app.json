{
  "expo": {
    "name": "P1SYBS Montør",
    "slug": "p1sybs-montor",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A1A"
    },
    "ios": {
      "bundleIdentifier": "dk.p1sybs.montor",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Face ID bruges til at logge dig ind i appen uden at skrive din kode.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dk.p1sybs.montor",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1A1A"
      },
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT"]
    },
    "plugins": ["expo-secure-store", "expo-local-authentication"]
  }
}
